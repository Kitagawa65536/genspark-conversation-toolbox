{
  "manifest_version": 3,
  "name": "Genspark Conversation Manager",
  "version": "2.6.3",
  "description": "Advanced Genspark conversation management - Download, search, save and manage conversations",

  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "tabs",
    "scripting"
  ],

  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],

  "content_scripts": [{
    "matches": ["https://*.genspark.ai/*", "https://genspark.ai/*"],
    "js": ["markdown.js", "content.js"],
    "run_at": "document_end"
  }],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Genspark Conversation Manager"
  },

  "background": {
    "service_worker": "background.js"
  }
}
